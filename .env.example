# Copy to backend/.env (pydantic-settings reads backend/.env, not this file
# directly -- see backend/app/core/config.py). Every line below is optional;
# the app runs with sensible defaults if you set nothing at all.

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Not used yet -- persistence is a later step.
DATABASE_URL=

# In-app assistant (backend/app/services/assistant.py). Bring-your-own-key:
# this project does not bundle or pay for a key on your behalf, so the chat
# widget stays honestly "not configured" until you set this yourself to an
# Anthropic API key (https://console.anthropic.com/). Leave blank to keep
# the assistant off -- the rest of the app works normally either way.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-3-5-haiku-latest
ASSISTANT_API_BASE_URL=https://api.anthropic.com
